---
import Layout from '../../layouts/Layout.astro';
import contact from '../../data/contact.json';
import GroupCard from '../../components/GroupCard.astro';
import Pagination from '../../components/Pagination.astro';
import RigDiagram from '../../components/RigDiagram.astro';
import TechnicalArticle from '../../components/TechnicalArticle.astro';
import Science from '../../components/Science.astro';
import SystemCards from '../../components/SystemCards.astro';
import HeadInAction from '../../components/HeadInAction.astro';
import Diagram from '../../components/Diagram.astro';
import GigapanCollection from '../../components/GigapanCollection.astro';
import GigapanCallout from '../../components/GigapanCallout.astro';
import { gigapanCollection } from '../../data/site-links.mjs';
import { groups, panoramas, themes, regions, groupItems, groupImage, imageFor, dateLabel, yearsLabel, featuredGroups, compareGroups, isGigapanGroup } from '../../data/catalog.mjs';
import { pages, languages, route, href, basePath, ui, panoramaOpenHref } from '../../lib/routes.mjs';

export function getStaticPaths() {
  return languages.flatMap((lang) => pages.map((page) => ({ params: { lang, route: route(page, lang).split('/').slice(1, -1).join('/') || undefined }, props: { lang, page } })));
}
const { lang, page } = Astro.props;
const t = (de, en) => lang === 'de' ? de : en;
const go = (kind, id, number) => href({ kind, id, page: number }, lang);
const system = go('project', 'panorama-system');
const workflow = go('project', 'workflow');
const group = page.kind === 'series' ? groups.find((g) => g.id === page.id) : null;
const panorama = page.kind === 'panorama' ? panoramas.find((p) => p.id === page.id) : null;
const parent = panorama ? groups.find((g) => g.id === panorama.groupId) : null;
const collection = page.kind === 'theme' ? themes.find((x) => x.id === page.id) : page.kind === 'region' ? regions.find((x) => x.id === page.id) : null;
const collectionGroups = collection ? groups.filter((g) => page.kind === 'theme' ? g.themes.includes(collection.id) : g.region === collection.id).sort(compareGroups(lang)) : [];
const offset = ((page.page || 1) - 1) * 9;
const siblings = panorama ? groupItems(panorama.groupId) : [];
const siblingIndex = siblings.findIndex((p) => p.id === panorama?.id);
const projectTitles = { 'panorama-system': t('Das Panoramasystem', 'The panorama system'), workflow: t('Vom Einzelbild zum Panorama', 'From photograph to panorama'), 'beehive-scale': t('Ein Versuch mit einer Bienenstockwaage', 'An experiment with a beehive scale'), '3d-printing': t('Erfahrungen mit 3D-Druck', 'Experiences with 3D printing') };
projectTitles.mechanics = t('Mechanik & Kamerakopf', 'Mechanics & camera head');
projectTitles.electronics = t('Elektronik & PanoBoard', 'Electronics & PanoBoard');
projectTitles.software = t('Software & Steuerung', 'Software & control');
const photoTitles = {landscapes:t('Landschaft & Reisen','Landscapes & travel'),aerial:t('Drohnenfotografie','Aerial photography')};
const title = photoTitles[page.kind] || (page.kind === 'home' ? t('Weite Blicke. Neue Perspektiven.', 'Wide views. New perspectives.') : group ? group.title[lang] : parent ? parent.title[lang] + ' · ' + dateLabel(panorama.date, lang) : collection ? collection.title[lang] : page.kind === 'astronomy' ? t('Astrofotografie','Astrophotography') : page.kind === 'science' ? t('Wissenschaft','Science') : page.kind === 'project' ? projectTitles[page.id] : page.kind === 'gigapan' ? t('Meine Panoramen auf Gigapan','My panoramas on Gigapan') : ui[lang][page.kind]);
const hero = panoramas.find((p) => p.originalId === 'Hochries-Panorama1');
const steps = t(['Ausrichten', 'Aufnehmen', 'Entwickeln', 'Stitchen', 'Zeigen'], ['Level', 'Capture', 'Develop', 'Stitch', 'Share']);
---
<Layout lang={lang} page={page} title={title}>
  {page.kind === 'project' && ['mechanics','electronics','software'].includes(page.id) && <div class="wrap"><section class="page-intro compact"><span class="eyebrow">HARDWARE & SOFTWARE / {projectTitles[page.id]}</span><h1>{projectTitles[page.id]}</h1><p>{page.id === 'mechanics' ? t('Der Kamerakopf mit Konstruktionszeichnungen, Stückliste, Abmessungen und Fotos seiner Entwicklung.','The camera head, illustrated with construction drawings, parts, dimensions and photographs of its development.') : page.id === 'electronics' ? t('Hier findest du die Platinenbilder: Schaltplan, Board-Layout und PanoBoard im Controllergehäuse.','Find the PCB images here: the schematic, board layout and PanoBoard in its enclosure.') : t('Von der Aufnahmeplanung bis zum Positionsprotokoll: Bedienoberfläche, Android und Windows sowie die Firmware.','From capture planning to position records: the user interface, Android and Windows clients, and firmware.')}</p></section><TechnicalArticle lang={lang} id={page.id}/></div>}
  {page.kind === 'astronomy' && <div class="wrap"><section class="page-intro compact"><span class="eyebrow">{t('WEBCAM- & VIDEOASTRONOMIE','WEBCAM & VIDEO ASTRONOMY')}</span><h1>{t('Den Himmel','A closer look')}<br/><span>{t('näher holen.','at the sky.')}</span></h1><p>{t('Planeten, ISS und Deep Sky. Frühe Aufnahmen am 10-Zoll-Dobson und die selbst gebaute Nachführplattform.','Planets, the ISS and deep sky. Early images with a 10-inch Dobsonian and a home-built tracking platform.')}</p></section><TechnicalArticle lang={lang} id="astronomy"/></div>}
  {page.kind === 'science' && <div class="wrap"><section class="page-intro compact"><span class="eyebrow">{t('FORSCHUNG & VERÖFFENTLICHUNGEN','RESEARCH & PUBLICATIONS')}</span><h1>{t('Experimentieren.','Experiment.')}<br/><span>{t('Verstehen.','Understand.')}</span></h1><p>{t('Bildverarbeitung, Plasmadiagnostik und DNA-Microarrays: Abschlussarbeiten, Veröffentlichungen und Vorträge.','Image processing, plasma diagnostics and DNA microarrays: theses, publications and talks.')}</p></section><Science lang={lang}/></div>}
  {page.kind === 'home' && <>
    <section class="home-intro wrap">
      <div class="eyebrow"><span class="status-dot"></span>{t('FOTOGRAFIE. TECHNIK. ENTDECKERGEIST.', 'PHOTOGRAPHY. ENGINEERING. CURIOSITY.')}</div>
      <div class="hero-copy"><h1>{t('Weite Blicke.', 'Wide views.')}<br/><span>{t('Neue Perspektiven.', 'New perspectives.')}</span></h1><div class="hero-description"><p>{t('Ich bin Tom. Ich fotografiere Landschaften bis ins Detail, entwickle die Technik dafür und suche nach dem besseren Weg zum fertigen Bild.', 'I’m Tom. I photograph landscapes in remarkable detail, build the technology behind the images and explore better ways to bring it all together.')}</p><a class="text-link" href={go('about')}>{t('Mehr über mich', 'A little about me')} <span>↗</span></a></div></div>
      <a class="hero-landscape" href={`${go('panorama',hero.id)}?start=1#panorama-viewer`} aria-label={t('Panorama vom Hochries entdecken', 'Explore the Hochries panorama')}>
        <img src={basePath(imageFor('Hochries-Panorama1'))} alt={t('Blick vom Hochries über Berge, Wälder und das bayerische Voralpenland', 'View from Hochries across mountains, forests and the Bavarian Alpine foothills')} width="2200" height="627" fetchpriority="high" />
        <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
        <span class="hero-image-label"><span class="mono">HOCHRIES · 09 / 2024</span><strong>{t('Ein Bild. Viel zu entdecken.', 'One image. So much to discover.')}</strong></span><span class="hero-open">{t('Hineinzoomen', 'Take a closer look')} <span>↗</span></span>
      </a>
      <div class="pillar-nav">
        {[['01', t('Panoramen erleben', 'Experience panoramas'), go('gallery'), t('Landschaften bis ins Detail', 'Landscapes in fine detail')], ['02', t('Hardware & Software', 'Hardware & software'), system, t('Das selbst entwickelte System', 'The system behind the images')], ['03', t('Workflow optimieren', 'Refine the workflow'), workflow, t('Vom ersten Bild zum Panorama', 'From first image to panorama')]].map(([n, label, url, sub]) => <a href={url}><span class="mono">{n}</span><span><strong>{label}</strong><small>{sub}</small></span><span class="pillar-arrow">↗</span></a>)}
      </div>
    </section>
    <section class="section wrap"><div class="section-heading"><div><span class="eyebrow">01 / {t('PANORAMEN', 'PANORAMAS')}</span><h2>{t('Ein Ort. Viele Momente.', 'One place. Many moments.')}</h2><p>{t('Vom Münchner Stadtrand bis ins Fichtelgebirge: Berge, Städte und vertraute Ausblicke im Wechsel der Jahreszeiten.', 'From the outskirts of Munich to the Fichtel Mountains: landscapes, cities and familiar views through the seasons.')}</p></div><a class="text-link" href={go('gallery')}>{t('Zur Sammlung', 'Explore the collection')} ↗</a></div><div class="group-grid">{featuredGroups.map((g, i) => <GroupCard group={g} lang={lang} index={i} />)}</div></section>
    <section class="engineering-feature wrap"><div class="engineering-copy"><span class="eyebrow">02 / HARDWARE & SOFTWARE</span><h2>{t('Die Idee hinter', 'The idea behind')}<br/>{t('den Bildern.', 'the images.')}</h2><p>{t('Ein selbst entwickelter Kamerakopf, eigene Elektronik und die passende Steuerungssoftware: Das Panoramasystem verbindet Mechanik, Präzision und fotografische Praxis.', 'A custom camera head, integrated electronics and dedicated control software: the panorama system brings together mechanics, precision and photographic practice.')}</p><a class="button primary" href={system}>{t('Das System kennenlernen', 'Explore the system')} <span>↗</span></a><nav class="engineering-shortcuts" aria-label={t('Direkt zu den technischen Details','Go straight to technical details')}><a href={go('project','mechanics')}>{t('Mechanik','Mechanics')} →</a><a href={go('project','electronics')}>{t('Elektronik & Platine','Electronics & PCB')} →</a><a href={go('project','software')}>Software →</a></nav><div class="technical-tags"><span>PAN / TILT</span><span>PANOBOARD</span><span>ANDROID + WINDOWS</span></div></div><RigDiagram lang={lang} /></section>
    <section class="section wrap"><div class="section-heading"><div><span class="eyebrow">03 / WORKFLOW</span><h2>{t('Gut aufnehmen.', 'Capture with care.')}<br/>{t('Details bewahren.', 'Preserve the detail.')}</h2></div><p class="heading-aside">{t('Ein horizontal ausgerichteter Kopf, die richtige Blende und kurze Belichtungszeiten schaffen die Grundlage. Danach folgen RAW-Entwicklung, Stitching und die interaktive Präsentation.', 'A level head, suitable aperture and short exposures lay the foundation. RAW development, stitching and interactive presentation follow.')}</p></div><div class="workflow-track">{steps.map((step, i) => <a href={`${workflow}#${lang === 'de' ? ['01--stativ-und-panoramakopf-ausrichten','03--raster-planen-und-die-bildserie-aufnehmen','04--raw-dateien-entwickeln','05--in-ptgui-ausrichten-und-stitchen','07--krpano-kacheln-erstellen-und-veröffentlichen'][i] : ['01--level-the-tripod-and-panorama-head','03--plan-the-grid-and-capture-the-sequence','04--develop-the-raw-files','05--align-and-stitch-in-ptgui','07--create-krpano-tiles-and-publish'][i]}`}><span class="mono">0{i+1}</span><strong>{step}</strong><span aria-hidden="true">{i === 4 ? '↗' : '→'}</span></a>)}</div><a class="text-link" href={workflow}>{t('Den Workflow entdecken', 'Explore the workflow')} ↗</a></section>
    <div class="wrap"><GigapanCallout lang={lang}/></div>
    <section class="closing-note wrap"><span class="eyebrow">PIXEL LABS / {t('PERSÖNLICH', 'PERSONAL')}</span><h2>{t('Aus Neugier wird ein Bild.', 'Curiosity becomes an image.')}<br/>{t('Und manchmal eine neue Idee.', 'And sometimes, a new idea.')}</h2><a class="text-link" href={go('photography')}>{t('Weitere Fotografie entdecken', 'Explore more photography')} ↗</a></section>
  </>}

  {page.kind === 'gigapan' && <div class="wrap"><section class="page-intro compact"><span class="eyebrow">GIGAPAN / {t('DAS ÖFFENTLICHE ARCHIV','THE PUBLIC ARCHIVE')}</span><h1>{t('Meine Panoramen','My panoramas')}<br/><span>{t('auf Gigapan.','on Gigapan.')}</span></h1><p>{t('99 Panoramen zum Suchen, Sortieren und direkten Öffnen. Die Bildtitel und Beschreibungen stammen aus meinem öffentlichen Gigapan-Archiv; einige Aufnahmen sind auch in dieser Galerie vertreten.','Search, sort and open 99 panoramas directly. Titles and original captions come from my public Gigapan archive; some images also appear in this gallery.')}</p><div class="button-row"><a class="button secondary" href={gigapanCollection} target="_blank" rel="noopener noreferrer">{t('Öffentliches Gigapan-Profil','Public Gigapan profile')} ↗</a><a class="text-link" href={go('gallery')}>{t('Zur Panorama-Galerie','Back to the panorama gallery')} →</a></div><p class="archive-note">{t('Verzeichnisstand: 25. Oktober 2026. Datum und Auflösung wie bei Gigapan angegeben; das Datum ist nicht bei jeder Aufnahme als Aufnahmedatum ausgewiesen. Originalbeschreibungen bleiben in ihrer ursprünglichen Sprache.','Directory snapshot: 25 October 2026. Dates and resolution are as listed by Gigapan; dates are not always identified as capture dates. Original captions retain their original language.')}</p></section><GigapanCollection lang={lang}/></div>}

  {page.kind === 'gallery' && <div class="wrap">
    <section class="page-intro"><span class="eyebrow">01 / {t('DIE SAMMLUNG', 'THE COLLECTION')}</span><h1>{t('Den Blick', 'Let your eyes')}<br/><span>{t('schweifen lassen.', 'wander.')}</span></h1><div class="intro-bottom"><p>{t('Von weiten Landschaften bis zur Skyline am Horizont. Entdecke Panoramen nach Thema oder Ort – und dieselben Ausblicke im Wandel der Zeit.', 'From wide landscapes to a skyline on the horizon. Discover panoramas by theme or place, and revisit the same views through time.')}</p><span class="mono collection-count">{panoramas.length} {t('AUFNAHMEN', 'IMAGES')} / {groups.length} {t('STANDORTGRUPPEN', 'VIEWPOINT GROUPS')}</span></div></section>
    <form class="viewpoint-picker" data-viewpoint-picker><label for="viewpoint-choice">{t('Standort direkt auswählen','Go straight to a viewpoint')}</label><div><select id="viewpoint-choice" required aria-label={t('Aufnahmestandort','Capture viewpoint')}><option value="">{t('Standort wählen …','Choose a viewpoint …')}</option>{[false,true].map(gigapan=><optgroup label={gigapan ? 'Gigapan' : t('Panorama-Galerie','Panorama gallery')}>{[...groups].filter(g=>isGigapanGroup(g)===gigapan).sort(compareGroups(lang)).map(g=><option value={go('series',g.id)} data-open={panoramaOpenHref(groupItems(g.id).at(-1),lang)}>{g.title[lang]} · {groupItems(g.id).length} {groupItems(g.id).length === 1 ? t('Aufnahme','image') : t('Aufnahmen','images')}</option>)}</optgroup>)}</select><button class="button primary" type="submit" value="open">{t('Panorama öffnen','Open panorama')} ↗</button><button class="button secondary" type="submit" value="series">{t('Bildserie ansehen','Browse the series')} →</button></div><p>{t('„Panorama öffnen“ zeigt die neueste Aufnahme. In der Serie findest du alle Jahrgänge mit Bildbeschreibung.','“Open panorama” shows the latest image. The series contains every year with full captions.')}</p></form><nav class="gallery-shortcuts" aria-label={t('Sammlung durchsuchen','Browse the collection')}><a href="#themen">{t('Nach Themen','By theme')} ↓</a><a href="#orte">{t('Nach Orten','By place')} ↓</a><a href={go('gigapan')}>{t('Meine Panoramen auf Gigapan','My panoramas on Gigapan')} →</a></nav><section class="section" id="themen"><div class="section-heading"><div><span class="eyebrow">{t('NACH THEMEN', 'BY THEME')}</span><h2>{t('Was möchtest du entdecken?', 'What would you like to explore?')}</h2></div></div><div class="theme-grid">{themes.map((theme, i) => <a class="theme-card" href={go('theme',theme.id)}>{imageFor(theme.image) && <img src={basePath(imageFor(theme.image))} alt="" width="1100" height="400" loading="lazy"/>}<span class="theme-content"><span class="mono">0{i+1} / {groups.filter((g)=>g.themes.includes(theme.id)).length} {t('STANDORTE', 'VIEWPOINTS')}</span><strong>{theme.title[lang]}</strong><small>{theme.description[lang]}</small></span><span class="theme-arrow">↗</span></a>)}</div></section>
    <section class="section no-top" id="orte"><div class="section-heading"><div><span class="eyebrow">{t('NACH ORTEN', 'BY PLACE')}</span><h2>{t('Landschaften und Städte nach Region.', 'Landscapes and cities by region.')}</h2><p>{t('Von Franken und München über die Alpen bis zu Reisezielen in aller Welt.', 'From Franconia and Munich to the Alps and destinations around the world.')}</p></div></div><div class="region-list">{regions.map((region,i)=><a href={go('region',region.id)}><span class="mono">0{i+1}</span><strong>{region.title[lang]}</strong><span class="region-count">{groups.filter((g)=>g.region===region.id).length} {t('Standortgruppen', 'viewpoint groups')}</span><span>↗</span></a>)}</div></section>
  <GigapanCallout lang={lang}/></div>}

  {collection && <div class="wrap"><section class="page-intro compact"><span class="eyebrow">{page.kind === 'theme' ? ui[lang].topic : ui[lang].region}</span><h1>{collection.title[lang]}</h1><p>{collection.description?.[lang] || t('Entdecke die Standorte dieser Region. Die Aufnahmen eines Standorts bleiben als Bildserie zusammen.', 'Explore viewpoints in this region. Images taken at the same viewpoint stay together as a series.')}</p><div class="filter-links">{(page.kind === 'theme' ? themes : regions).map((item)=><a aria-current={item.id === collection.id ? 'page' : undefined} href={go(page.kind,item.id)}>{item.title[lang]}</a>)}</div></section><div class="results-meta"><span class="mono">{collectionGroups.length} {t('STANDORTGRUPPEN', 'VIEWPOINT GROUPS')}</span><span>{t('Nach Standort gruppiert', 'Grouped by viewpoint')}</span></div><div class="group-grid collection-grid">{collectionGroups.slice(offset,offset+9).map((g,i)=><GroupCard group={g} lang={lang} index={offset+i}/>)}</div><Pagination page={page} lang={lang} count={collectionGroups.length}/></div>}

  {group && <div class="wrap"><section class="page-intro compact"><span class="eyebrow">{t('STANDORTSERIE', 'VIEWPOINT SERIES')} / {yearsLabel(group)}</span><h1>{group.title[lang]}</h1><p class="series-direction">{group.direction[lang]}</p><p>{group.description[lang]}</p></section><div class="series-toolbar"><span class="mono">{groupItems(group.id).length} {t('AUFNAHMEN · CHRONOLOGISCH', 'IMAGES · CHRONOLOGICAL')}</span><a class="text-link" href={`${go('panorama',groupItems(group.id).at(-1).id)}?start=1#panorama-viewer`}>{t('Zur neuesten Aufnahme', 'Go to the latest image')} ↗</a></div><div class="timeline">{groupItems(group.id).slice(offset,offset+9).map((p,i)=><article class="timeline-item"><div class="timeline-date"><span class="mono">{String(offset+i+1).padStart(2,'0')}</span><time datetime={p.date || undefined}>{dateLabel(p.date,lang)}</time>{p.direction && <small>{p.direction[lang]}</small>}</div><a class:list={['timeline-image', {'no-preview': !p.image}]} href={panoramaOpenHref(p,lang)} target={p.url.includes('gigapan.com') ? '_blank' : undefined} rel={p.url.includes('gigapan.com') ? 'noopener noreferrer' : undefined}>{p.image ? <img src={basePath(p.image)} alt={`${group.title[lang]}, ${dateLabel(p.date,lang)}${p.direction ? ' · '+p.direction[lang] : ''}`} width="1600" height="450" loading="lazy"/> : <span class="missing-preview"><span class="crosshair">+</span>{ui[lang].missing}<small>{t('Die interaktive Originalansicht lässt sich auf der Detailseite öffnen.', 'The original interactive view can be opened on the detail page.')}</small></span>}<span class="timeline-open">{t('Panorama öffnen','Open panorama')} ↗</span></a><div class="timeline-caption"><p>{p.description[lang]}</p><a class="text-link" href={panoramaOpenHref(p,lang)} target={p.url.includes('gigapan.com') ? '_blank' : undefined} rel={p.url.includes('gigapan.com') ? 'noopener noreferrer' : undefined}>{t('Panorama öffnen','Open panorama')} ↗</a><a class="text-link" href={`${go('panorama',p.id)}#zur-aufnahme`}>{t('Bildbeschreibung & Aufnahmedetails','Caption & capture details')} →</a></div></article>)}</div><Pagination page={page} lang={lang} count={groupItems(group.id).length}/><aside class="series-footnote">{t('Geordnet nach dem Aufnahmedatum der ursprünglichen Bildbeschreibung. Bei gleichem Monat bleibt die ursprüngliche Reihenfolge erhalten. Vorschauen zeigen teils Ausschnitte; im Viewer ist das gesamte Panorama erreichbar.', 'Ordered by the capture date in the original caption. Images from the same month retain their original order. Some previews show crops; the complete panorama is available in the viewer.')}</aside></div>}

  {panorama && <div class="wrap"><section class="page-intro compact panorama-heading"><span class="eyebrow">{dateLabel(panorama.date,lang)}{panorama.direction ? ' / '+panorama.direction[lang] : ''}</span><h1>{parent.title[lang]}</h1><p>{parent.direction[lang]}</p></section><section id="panorama-viewer" class="panorama-viewer" data-viewer data-url={panorama.url} data-title={`${parent.title[lang]} – ${dateLabel(panorama.date,lang)}`} data-loading={t('Panorama wird geladen. Falls die Ansicht leer bleibt, nutze „Direkt öffnen“.', 'Loading panorama. If the view stays blank, use “Open directly”.')} data-ready={t('Externer Panorama-Viewer geöffnet. Bei Anzeigeproblemen: „Direkt öffnen“.', 'External panorama viewer opened. If needed, use “Open directly”.')}><nav class="viewer-navigation" aria-label={t('Navigation am Panorama','Panorama navigation')}><span>{parent.title[lang]} · {dateLabel(panorama.date,lang)}</span><div><a href={go('series',parent.id,Math.floor(siblingIndex/9)+1)}>← {t('Bildserie','Series')}</a><a href={go('gallery')}>{ui[lang].all}</a><a href={go('home')}>{ui[lang].home}</a></div></nav>
      <div class:list={['viewer-poster',{'no-preview': !panorama.image}]}>{panorama.image && <img src={basePath(panorama.image)} alt={parent.direction[lang]} width="2200" height="700"/>}<div class="viewer-start"><span class="viewer-crosshair" aria-hidden="true">+</span>{panorama.url.startsWith('https:') ? <button class="button primary" data-start-viewer>{t('Interaktives Panorama starten', 'Start interactive panorama')} <span>↗</span></button> : <a class="button primary" href={panorama.url} target="_blank" rel="noopener noreferrer">{t('Panorama auf Gigapan öffnen', 'Open panorama on Gigapan')} ↗</a>}<p>{t('Hineinzoomen. Verschieben. Details entdecken.', 'Zoom in. Move around. Discover the details.')}</p></div></div>
      <div class="viewer-status" role="status" aria-live="polite"></div>
    </section><div class="viewer-actions"><a class="text-link" href="#zur-aufnahme">{t('Bildbeschreibung & Details','Caption & details')} ↓</a><span>{t('Die interaktive Ansicht benötigt Internet.', 'The interactive view requires an internet connection.')}</span><div><button class="text-link fullscreen-button" data-fullscreen hidden>{t('Vollbild', 'Fullscreen')} ⛶</button><a class="text-link" href={panorama.url} target="_blank" rel="noopener noreferrer">{t('Direkt öffnen', 'Open directly')} ↗</a></div></div><div class="detail-grid" id="zur-aufnahme"><div><span class="eyebrow">{t('ZUR AUFNAHME', 'ABOUT THE IMAGE')}</span><h2>{parent.direction[lang]}</h2><p>{panorama.description[lang]}</p></div><aside><details><summary>{t('Aufnahme & Herkunft', 'Capture & source')}</summary><dl><dt>{t('Standort', 'Viewpoint')}</dt><dd>{parent.title[lang]}</dd><dt>{t('Aufnahmedatum', 'Capture date')}</dt><dd>{dateLabel(panorama.date,lang)}</dd><dt>{t('Original-Viewer', 'Original viewer')}</dt><dd>{panorama.url.includes('gigapan') ? 'Gigapan' : 'krpano / CloudFront'}</dd></dl><a href={lang==='de' ? 'https://sites.google.com/site/thomasnaiser/home/gigapixel-panorama-bilder' : 'https://sites.google.com/site/thomasnaiser/home/gigapixel-panorama-gallery'} target="_blank" rel="noopener noreferrer">{t('Ursprüngliche Bildbeschreibung', 'Original image caption')} ↗</a></details><a class="related-link" href={go('project','mechanics')}>{t('Mechanik & Kamerakopf','Mechanics & camera head')} ↗</a><a class="related-link" href={go('project','electronics')}>{t('Platinenbilder & Elektronik','PCB images & electronics')} ↗</a><a class="related-link" href={go('project','software')}>{t('Software & Steuerung','Software & control')} ↗</a><a class="related-link" href={system}>{t('Die Technik hinter dem Bild', 'The technology behind the image')} ↗</a><a class="related-link" href={workflow}>{t('So entsteht das Panorama', 'How the panorama is made')} ↗</a></aside></div><nav class="series-navigation" aria-label={t('Aufnahmen derselben Serie', 'Images in this series')}>{siblingIndex > 0 ? <a href={go('panorama',siblings[siblingIndex-1].id)}><small>← {t('Vorherige Aufnahme', 'Previous image')}</small><strong>{dateLabel(siblings[siblingIndex-1].date,lang)}</strong></a> : <span/>}<a class="series-middle" href={go('series',parent.id)}>{t('Ganze Bildserie', 'Complete series')}<small>{siblingIndex+1} / {siblings.length}</small></a>{siblingIndex < siblings.length-1 ? <a href={go('panorama',siblings[siblingIndex+1].id)}><small>{t('Nächste Aufnahme', 'Next image')} →</small><strong>{dateLabel(siblings[siblingIndex+1].date,lang)}</strong></a> : <span/>}</nav></div>}

  {(page.kind === 'projects' || (page.kind === 'project' && page.id === 'panorama-system')) && <div class="wrap"><section class="page-intro"><span class="eyebrow">02 / HARDWARE & SOFTWARE</span><div class="system-intro"><div><h1>{t('Selbst entwickelt.', 'Custom built.')}<br/><span>{t('Für den weiten Blick.', 'For a wider view.')}</span></h1><p>{t('Ein Panoramasystem entsteht dort, wo Fotografie, Mechanik und Software zusammenkommen. Ich entwickle diese Teile gemeinsam – und erprobe sie draußen in der Landschaft.', 'A panorama system takes shape where photography, mechanics and software meet. I develop these parts together and put them to work out in the landscape.')}</p><div class="button-row"><a class="button primary" href="#hardware">Hardware ↓</a><a class="button secondary" href="#software">Software ↓</a><a class="text-link" href="#kopf-in-aktion">{t('Videos ansehen','Watch the videos')} ↓</a></div></div><RigDiagram lang={lang}/></div></section><SystemCards lang={lang}/><HeadInAction lang={lang}/><Diagram id="hardware" lang={lang}/><div class="construction-link"><a class="button primary" href={go('project','mechanics')}>{t('Ausführliche Mechanikbeschreibung','Detailed mechanics article')} ↗</a><p>{t('Konstruktionszeichnungen, Stückliste und Fotos des Kamerakopfs. Platinenbilder findest du unter Elektronik.','Construction drawings, parts and photographs of the head. PCB images are under Electronics.')}</p></div><section class="system-summary"><span class="mono">{t('DAS PRINZIP', 'THE PRINCIPLE')}</span><p>{t('Planen am Bildschirm. Präzise bewegen. Bilder aufnehmen. Positionen weitergeben.', 'Plan on screen. Move precisely. Capture images. Pass on the positions.')}</p></section><section class="section two-column" id="hardware"><div><span class="eyebrow">HARDWARE / PAN & TILT</span><h2>{t('Bewegung braucht', 'Movement needs')}<br/>{t('eine gute Grundlage.', 'a solid foundation.')}</h2><p>{t('Der motorisierte Kamerakopf bewegt die Kamera durch die geplante Bildfolge. Absolute Winkelgeber messen die Positionen der beiden Achsen. Die PanoBoard-Elektronik verbindet Steuerung, Motortreiber, Bluetooth und Kameraauslösung.', 'The motorized head moves the camera through the planned sequence. Absolute encoders measure the two axis positions. PanoBoard electronics connect the controller, motor drivers, Bluetooth and camera trigger.')}</p></div><div class="spec-list"><div><span class="mono">01 / MECHANIK</span><h3>{t('Kamerakopf & Ausrichtung', 'Camera head & alignment')}</h3><p>{t('Stabilität, Kamerabalance und passende Bewegungsgrenzen sind entscheidend für brauchbare Aufnahmen.', 'Stability, camera balance and suitable movement limits are essential for usable photographs.')}</p><a class="text-link" href={go('project','mechanics')}>{t('Konstruktionsbilder & Stückliste','Construction images & parts list')} ↗</a></div><div><span class="mono">02 / ELEKTRONIK</span><h3>PanoBoard</h3><p>{t('Integrierte Elektronik statt vieler einzelner Baugruppen. Die Dokumentation unterscheidet Board-Revisionen und den Nano-R4-Umbau.', 'Integrated electronics in place of separate modules. The documentation distinguishes board revisions and the Nano R4 conversion.')}</p><a class="text-link" href={go('project','electronics')}>{t('Platinenfotos, Schaltplan & Aufbau','PCB photographs, schematic & construction')} ↗</a><a class="text-link" href="https://github.com/TomNaiser/PanoBoard" target="_blank" rel="noopener noreferrer">{t('Quelldateien auf GitHub', 'Source files on GitHub')} ↗</a></div><div><span class="mono">03 / FIRMWARE</span><h3>PanoDuinoControl</h3><p>{t('Bewegung, Positionsrückmeldung, Beruhigungsprüfung und Kameraauslösung laufen auf dem Controller.', 'Movement, position feedback, settling checks and shutter triggering run on the controller.')}</p><a class="text-link" href="https://github.com/TomNaiser/PanoDuinoControl" target="_blank" rel="noopener noreferrer">{t('Zur Firmware', 'Explore the firmware')} ↗</a></div></div></section><section class="section two-column" id="software"><div><span class="eyebrow">SOFTWARE / PLAN & CONTROL</span><h2>{t('Ein Plan.', 'One plan.')}<br/>{t('Viele Einzelbilder.', 'Many photographs.')}</h2><p>{t('Mit Android oder Windows plane ich die Bildserie, verfolge den Fortschritt und sichere die gemessenen Positionen. Gespeicherte Läufe und Restaufträge helfen, nach einer Unterbrechung gezielt weiterzuarbeiten. Die Positionsdaten gehen anschließend an PTGui.', 'Android or Windows lets me plan the sequence, follow progress and save measured positions. Stored runs and continuation jobs help resume work after an interruption. Position records then pass to PTGui.')}</p><a class="button primary" href={go('project','software')}>{t('Bedienoberfläche & Steuerung','User interface & control')} ↗</a><a class="text-link" href="https://github.com/TomNaiser/PanoramaSoftware" target="_blank" rel="noopener noreferrer">{t('Software & Dokumentation', 'Software & documentation')} ↗</a></div><a class="software-app-preview" href={`${go('project','software')}#android-app-screenshot`}><img src={basePath('images/articles/software/android-app.png')} alt={t('Aufnahmeplanung in der Android-App PanoramaControl','Capture planning in the PanoramaControl Android app')} width="2340" height="1080" loading="lazy"/><span>{t('Android-App: Screenshot & Bedienung','Android app: screenshot & operation')} →</span></a></section><details class="wide-details"><summary>{t('Technische Vertiefung: Steuerung, Wiederaufnahme und Projektgeschichte', 'Technical details: control, recovery and project history')}</summary><div class="prose"><p>{t('Die aktuelle Beschreibung des Systems nennt einen Arduino Nano R4, absolute AS5048B-Winkelgeber und die PanoBoard-Elektronik. Beide Apps bieten lokale Aufnahmearchive, Restaufträge und vollständige XML-Zwischenstände. Die Softwareseite nennt den gemeinsam geprüften Referenzstand und verlinkt die Funktionsübersicht und Messberichte.', 'The current system description names an Arduino Nano R4, absolute AS5048B encoders and PanoBoard electronics. Both apps offer local capture archives, continuation jobs and complete XML snapshots. The software page lists the tested system reference and links to the feature matrix and measurement reports.')}</p><p>{t('Frühere Aufbauten mit Arduino Mega, Pololu und älteren Boards gehören zur Entwicklungsgeschichte. Ihre Teilelisten werden nicht mit aktuellen Umbauanleitungen vermischt.', 'Earlier Arduino Mega, Pololu and older board designs belong to the project history. Their parts lists are kept separate from current conversion instructions.')}</p><a href="https://github.com/TomNaiser/PanoramaSoftware/blob/main/docs/08-funktionsstand.md" target="_blank" rel="noopener noreferrer">{t('Funktionsstand & Unterschiede', 'Feature status & differences')} ↗</a></div></details><section class="section workflow-callout"><span class="eyebrow">03 / WORKFLOW</span><h2>{t('Der Workflow beginnt am Stativ.', 'The workflow starts at the tripod.')}</h2><p>{t('Ausrichten, Blende und Belichtungszeit prüfen, aufnehmen und verarbeiten: der vollständige Weg zum Panorama.', 'Level the head, check aperture and exposure time, capture and process: the complete path to a panorama.')}</p><a class="text-link" href={workflow}>{t('Zum Aufnahme- und Verarbeitungsworkflow', 'Explore the capture and processing workflow')} ↗</a></section>{page.kind === 'projects' && <section class="workshop section"><span class="eyebrow">{t('AUS DER WERKSTATT', 'FROM THE WORKSHOP')}</span><h2>{t('Auch mal etwas ausprobieren.', 'Room to experiment, too.')}</h2><div class="workshop-links"><a href={go('project','beehive-scale')}><small>{t('EIN VERSUCH', 'AN EXPERIMENT')}</small><strong>{t('Bienenstockwaage', 'Beehive scale')}</strong><span>↗</span></a><a href={go('project','3d-printing')}><small>{t('ERFAHRUNGEN', 'EXPERIENCES')}</small><strong>{t('3D-Druck', '3D printing')}</strong><span>↗</span></a></div></section>}</div>}

  {page.kind === 'project' && page.id === 'workflow' && <div class="wrap"><section class="page-intro"><span class="eyebrow">03 / WORKFLOW</span><h1>{t('Gute Panoramen', 'Good panoramas')}<br/><span>{t('beginnen vor dem ersten Bild.', 'start before the first photograph.')}</span></h1><p>{t('Zuerst Aufnahmefehler vermeiden, dann die Bildserie entwickeln, zusammenfügen und präsentieren. Hier beschreibe ich meinen Ablauf, die verwendeten Werkzeuge und Erfahrungen aus der Praxis.', 'First avoid capture errors, then develop, stitch and present the sequence. Here I describe my process, tools and practical experience.')}</p></section><TechnicalArticle lang={lang} id="workflow"/><section class="section no-top"><span class="eyebrow">{t('WERKZEUGE FÜR KONKRETE PROBLEME', 'TOOLS FOR SPECIFIC PROBLEMS')}</span><div class="tool-grid"><article><span class="mono">01 / VIGNETTING</span><h2>{t('Helligkeitsmuster korrigieren.', 'Correct brightness patterns.')}</h2><p>{t('Ein Kalibrierungsansatz für hartnäckige Vignettierungsartefakte in 16-Bit-TIFF-Bildern.', 'A calibration approach for stubborn vignetting artefacts in 16-bit TIFF images.')}</p><a class="text-link" href="https://github.com/TomNaiser/Gigapixel-Tools/blob/main/VignettingCorrection.py" target="_blank" rel="noopener noreferrer">{t('Skript ansehen', 'View the script')} ↗</a></article><article><span class="mono">02 / GRID REPAIR</span><h2>{t('Lose Bilder wieder einordnen.', 'Put loose images back in place.')}</h2><p>{t('Unverbundene Himmel- und Vordergrundbilder anhand des Aufnahmerasters ausrichten.', 'Arrange unconnected sky and foreground images using the capture grid.')}</p><a class="text-link" href="https://github.com/TomNaiser/Gigapixel-Tools/blob/main/LooseTileAlignment.py" target="_blank" rel="noopener noreferrer">{t('Skript ansehen', 'View the script')} ↗</a></article></div></section></div>}

  {['landscapes','aerial'].includes(page.kind) && <div class="wrap"><section class="page-intro compact"><span class="eyebrow">{t('FOTOGRAFIE','PHOTOGRAPHY')}</span><h1>{photoTitles[page.kind]}</h1><p>{page.kind==='landscapes' ? t('Morgenlicht und Polarlicht, Felslandschaften in Petra und Perspektiven auf New York. Bilder von unterwegs und vor der Haustür.','Morning light and aurora, Petra’s sandstone and views of New York. Photographs from travels and close to home.') : t('Ein selbst gebauter Hexakopter, eine frühe GoPro und die Suche nach ruhigen Bildern aus der Luft.','A home-built hexacopter, an early GoPro and the challenge of steady images from the air.')}</p></section><TechnicalArticle lang={lang} id={page.kind}/></div>}

  {page.kind === 'photography' && <div class="wrap"><section class="page-intro"><span class="eyebrow">{t('WEITERE FOTOGRAFIE', 'MORE PHOTOGRAPHY')}</span><h1>{t('Die Neugier', 'Curiosity')}<br/><span>{t('bleibt nicht stehen.', 'keeps moving.')}</span></h1><p>{t('Landschaften, Reisebilder, Astronomie und frühe Drohnenaufnahmen: Jede Sammlung zeigt die Bilder und erklärt, wie sie entstanden sind.', 'Landscapes, travel, astronomy and early aerial photographs: explore the images and the story of how they were made.')}</p></section><div class="photo-collections">{[[t('Landschaft & Reisen','Landscapes & travel'), t('Polarlicht bei Germering, Petra, Galiläa und New York.','Aurora near Germering, Petra, Galilee and New York.'),'landscapes','01','landscapes/01.webp'],[t('Astrofotografie','Astrophotography'),t('Planeten, ISS-Video und Deep-Sky-Aufnahmen mit einem Dobson-Teleskop.','Planets, an ISS video and deep-sky images with a Dobsonian telescope.'),'astronomy','02','astronomy/06.webp'],[t('Drohnenfotografie','Aerial photography'),t('Winterpanorama und Kameratechnik am selbst gebauten Hexakopter.','A winter panorama and camera engineering on a home-built hexacopter.'),'aerial','03','aerial/00.webp']].map(([heading,description,kind,n,image])=><article><a class="photo-collection-image" href={go(kind)} aria-label={heading}><img src={basePath(`images/articles/${image}`)} alt="" width="900" height="600" loading="lazy"/></a><span class="mono">{n} / {t('BILDSAMMLUNG','PHOTO COLLECTION')}</span><h2>{heading}</h2><p>{description}</p><a class="text-link" href={go(kind)}>{t('Aufnahmen & Hintergründe entdecken','Explore images & background')} →</a></article>)}</div></div>}

  {page.kind === 'about' && <div class="wrap"><section class="page-intro"><span class="eyebrow">{t('ÜBER MICH', 'ABOUT')}</span><h1>Tom's Pixel Labs.<br/><span>{t('Neugier als Antrieb.', 'Driven by curiosity.')}</span></h1><p>{t('Fotografie, selbst entwickelte Technik und wissenschaftliches Arbeiten treffen hier zusammen. Mich interessiert das Bild ebenso wie der Weg dorthin.','Photography, custom-built technology and scientific work come together here. I’m interested in the image as much as the process behind it.')}</p></section><section class="two-column section no-top"><div><h2>{t('Sehen. Verstehen. Bauen.','Observe. Understand. Build.')}</h2><p>{t('Mit der Panoramafotografie beschäftige ich mich seit meiner ersten Digitalkamera im Jahr 2003. Aus dem Wunsch nach zuverlässigeren Aufnahmen entstand ein eigenes System aus Mechanik, Elektronik und Software.','I have explored panorama photography since my first digital camera in 2003. The desire for more reliable capture grew into a system of custom mechanics, electronics and software.')}</p><a class="text-link" href={system}>{t('Zum Panoramasystem','Explore the panorama system')} ↗</a></div><div class="profile-panel"><span class="eyebrow">{t('WISSENSCHAFTLICHER HINTERGRUND','SCIENTIFIC BACKGROUND')}</span><h3>{t('Physik & Bildverarbeitung','Physics & image processing')}</h3><p>{t('Abschlussarbeiten zu Robotik und Plasmadiagnostik sowie eine Dissertation an der Universität Bayreuth zur Herstellung und Charakterisierung von DNA-Microarrays.','Theses on robotics and plasma diagnostics, followed by a doctorate at the University of Bayreuth on fabrication and characterization of DNA microarrays.')}</p><a class="text-link" href={go('science')}>{t('Publikationen & Vorträge','Publications & talks')} ↗</a></div></section></div>}

  {page.kind === 'contact' && <div class="wrap"><section class="page-intro contact-intro"><span class="eyebrow">{t('KONTAKT','CONTACT')}</span><h1>{t('Fragen? Ideen?','Questions? Ideas?')}<br/><span>{t('Schreib mir.','Get in touch.')}</span></h1><p>{t('Zu den Panoramen, zur Technik oder zum Workflow – ich freue mich über den Austausch.','About the panoramas, the technology or the workflow – I welcome the conversation.')}</p><button type="button" class="email-bitmap-button" data-email-contact data-code={contact.codepoints.join('.')} aria-label={t('E-Mail schreiben','Write an email')}><img class="email-dark" src={basePath('images/contact/email-dark.png')} alt={t('E-Mail-Adresse als Bild. Zum Schreiben anklicken.','Email address as an image. Click to compose a message.')} width="500" height="65"/><img class="email-light" src={basePath('images/contact/email-light.png')} alt="" aria-hidden="true" width="500" height="65"/><span aria-hidden="true">↗</span></button><p class="contact-instruction">{t('Adresse anklicken, um das Mailprogramm zu öffnen.','Click the address to open your email app.')}</p><a class="text-link" href="https://github.com/TomNaiser" target="_blank" rel="noopener noreferrer">{t('Projekte auf GitHub','Projects on GitHub')} ↗</a></section></div>}

  {page.kind === 'project' && ['beehive-scale','3d-printing'].includes(page.id) && <div class="wrap"><section class="page-intro compact"><span class="eyebrow">{page.id==='beehive-scale' ? t('EIN VERSUCH','AN EXPERIMENT') : t('ERFAHRUNGEN','EXPERIENCES')}</span><h1>{projectTitles[page.id]}</h1></section><article class="prose standalone">{page.id==='beehive-scale' ? <><p>{t('Ich habe ausprobiert, wie sich das Gewicht eines Bienenstocks erfassen und per Funk übertragen lässt. Ein kleiner Versuch mit Sensoren, LoRa und einem Raspberry Pi – mit technischen Notizen zum Aufbau.','I experimented with measuring the weight of a beehive and transmitting the data by radio. A small experiment using sensors, LoRa and a Raspberry Pi, with technical notes about the setup.')}</p><h2>{t('Der Ansatz','The approach')}</h2><p>{t('ESP32-Sensorknoten erfassen Messwerte und senden sie per LoRa an eine Basisstation. Die ursprünglichen Notizen beschreiben eine Gewichtsmessung mit HX711 und die Datenerfassung auf einem Raspberry Pi.','ESP32 sensor nodes collect measurements and transmit them via LoRa to a base station. The original notes describe HX711-based weight measurement and data collection on a Raspberry Pi.')}</p><details><summary>{t('Technische Notizen zum Versuch','Technical notes on the experiment')}</summary><p>ESP32 / LoRa · HX711 · Raspberry Pi · Python</p><a href="https://github.com/TomNaiser/LoRa-Sensor-Monitoring" target="_blank" rel="noopener noreferrer">{t('Quellcode ansehen','View source code')} ↗</a></details></> : <><p>{t('2010 habe ich einen MakerBot Thing-O-Matic als Bausatz gekauft. Das frühe Gerät verlangte viel Pflege und Anpassung. Die späteren Erfahrungen mit einem Ultimaker 2 stehen für einen deutlich unkomplizierteren Arbeitsablauf.','In 2010, I bought a MakerBot Thing-O-Matic kit. The early machine required considerable maintenance and adjustment. Later experience with an Ultimaker 2 reflects a much more straightforward workflow.')}</p><p>{t('Heute verwende ich einen Prusa i3 MK3. Seine modernere Motortreibertechnik macht den Betrieb im Alltag deutlich leiser. Besonders gefällt mir, dass die Maschine viele ihrer eigenen Kunststoffteile selbst drucken kann: Ersatzteile und Anpassungen werden damit Teil der eigenen Werkstatt.','I now use a Prusa i3 MK3. Its newer motor-driver technology makes everyday operation much quieter. I especially like that the machine can print many of its own plastic parts, making replacements and modifications part of my own workshop.')}</p></>}</article></div>}

  <script>
    import { isolateViewerScroll, interactiveViewerUrl } from '../../lib/viewer-controls.mjs';
    document.querySelector('[data-email-contact]')?.addEventListener('click', (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      const address = String.fromCodePoint(...button.dataset.code.split('.').map(Number));
      window.location.href = 'mailto:' + address;
    });
    document.querySelector('[data-viewpoint-picker]')?.addEventListener('submit', (event) => {
      event.preventDefault();
      const form = event.currentTarget as HTMLFormElement;
      const select = form.querySelector('select');
      const option = select.selectedOptions[0];
      if (!option?.value) return;
      const mode = (event as SubmitEvent).submitter as HTMLButtonElement;
      window.location.assign(mode?.value === 'series' ? option.value : option.dataset.open);
    });
    const viewer = document.querySelector('[data-viewer]');
    const trigger = viewer?.querySelector('[data-start-viewer]');
    const startViewer = () => {
      if (!viewer || viewer.dataset.active === 'true') return;
      const frame = document.createElement('iframe');
      frame.addEventListener('load', () => { viewer.querySelector('.viewer-status').textContent = viewer.dataset.ready; });
      frame.src = interactiveViewerUrl(viewer.dataset.url);
      frame.title = viewer.dataset.title;
      frame.allow = 'fullscreen';
      frame.allowFullscreen = true;
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      viewer.querySelector('.viewer-poster')?.replaceWith(frame);
      viewer.dataset.active = 'true';
      isolateViewerScroll(viewer);
      viewer.querySelector('.viewer-status').textContent = viewer.dataset.loading;
      const fullscreen = document.querySelector('[data-fullscreen]');
      if (document.fullscreenEnabled) fullscreen.hidden = false;
    };
    trigger?.addEventListener('click', startViewer);
    if (trigger && new URLSearchParams(window.location.search).get('start') === '1') {
      startViewer();
      requestAnimationFrame(() => viewer.scrollIntoView({block:'start',behavior:'instant'}));
    }
    document.querySelector('[data-fullscreen]')?.addEventListener('click', async () => {
      try { await viewer.requestFullscreen(); } catch { /* Direct link remains available. */ }
    });
  </script>
