---
import { basePath, href } from '../lib/routes.mjs';
const { lang } = Astro.props;
const t = (de,en) => lang === 'de' ? de : en;
const steps = [
  { image:'02', label:t('Blick vom Herzogstand','View from Herzogstand'), alt:t('Blick vom Herzogstand über das bayerische Alpenvorland in Richtung München','View from Herzogstand across the Bavarian Alpine foreland towards Munich'), caption:t('Vom Herzogstand schaue ich nach Norden über das Alpenvorland bis nach München.','Looking north from Herzogstand across the Alpine foreland towards Munich.') },
  { image:'03', label:t('Richtung München','Towards Munich'), alt:t('Vergrößerter Ausschnitt desselben Panoramas mit München am Horizont','A closer crop of the same panorama with Munich on the horizon'), caption:t('Ein Stück näher heran: Am Horizont taucht München auf.','A little closer: Munich comes into view on the horizon.') },
  { image:'04', label:t('München im Detail','Munich in detail'), alt:t('Vergrößerter Blick vom Herzogstand auf die Münchner Innenstadt und die Allianz Arena','A magnified view from Herzogstand showing central Munich and the Allianz Arena'), caption:t('Jetzt lassen sich die Münchner Innenstadt und die Allianz Arena erkennen – trotz des Dunsts über der Stadt.','A closer look reveals central Munich and the Allianz Arena through the haze.') },
];
---
<section class="section zoom-example" id="herzogstand-zoom" data-zoom-example>
  <div class="section-heading"><div><span class="eyebrow">{t('EIN PANORAMA, DREI AUSSCHNITTE','ONE PANORAMA, THREE CROPS')}</span><h2>{t('Vom Herzogstand bis München.','From Herzogstand to Munich.')}</h2><p>{t('Erst das Alpenvorland, dann München am Horizont: Mit jedem Ausschnitt kommen neue Details dazu. Im stärksten Zoom sind Innenstadt und Allianz Arena zu erkennen.','First the Alpine foreland, then Munich on the horizon. Each closer view reveals more detail, including the city centre and the Allianz Arena.')}</p></div><a class="text-link" href={href({kind:'gallery'},lang)}>{t('Panoramen entdecken','Explore panoramas')} ↗</a></div>
  <div class="zoom-choices" role="group" aria-label={t('Bildausschnitt wählen','Choose a crop')}>
    {steps.map((step,i)=><button type="button" data-zoom-choice={i} aria-pressed={i===0 ? 'true':'false'} aria-controls={`herzogstand-step-${i}`}>{step.label}</button>)}
  </div>
  {steps.map((step,i)=><figure class="zoom-panel" data-zoom-panel={i} id={`herzogstand-step-${i}`} hidden={i!==0}>
    <a class="article-image-link" href={basePath(`images/articles/hardware/${step.image}.webp`)} target="_blank" rel="noopener noreferrer"><img src={basePath(`images/articles/hardware/${step.image}.webp`)} alt={step.alt} width={step.image==='04' ? 1270:1280} height={step.image==='02' ? 419:step.image==='03' ? 494:485} loading="lazy"/></a><figcaption>{step.caption}</figcaption>
  </figure>)}
  <noscript><p>{t('Weitere Ausschnitte direkt öffnen:','Open the other crops directly:')} <a href={basePath('images/articles/hardware/03.webp')}>{steps[1].label}</a> · <a href={basePath('images/articles/hardware/04.webp')}>{steps[2].label}</a></p></noscript>
</section>
<script>
  for (const root of document.querySelectorAll('[data-zoom-example]')) {
    const buttons=[...root.querySelectorAll<HTMLButtonElement>('[data-zoom-choice]')];
    const panels=[...root.querySelectorAll<HTMLElement>('[data-zoom-panel]')];
    buttons.forEach((button,index)=>button.addEventListener('click',()=>{
      buttons.forEach((item,i)=>item.setAttribute('aria-pressed',String(i===index)));
      panels.forEach((panel,i)=>panel.hidden=i!==index);
    }));
  }
</script>
<style>
  .zoom-example{border-top:1px solid var(--line)}
  .section-heading p{max-width:690px;font-size:15px;margin-top:18px;color:var(--muted)}
  .zoom-choices{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:22px}
  .zoom-choices button{font:inherit;font-size:13px;border:1px solid var(--line);padding:12px 18px;background:var(--surface);color:var(--ink);cursor:pointer;border-radius:var(--radius)}
  .zoom-choices button[aria-pressed=true]{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
  .zoom-panel{margin:0}.zoom-panel[hidden]{display:none}
  .zoom-panel img{display:block;width:100%;height:auto;aspect-ratio:1280/494;object-fit:contain;background:var(--surface)}
  figcaption{font-size:13px;line-height:1.7;margin-top:13px;color:var(--muted)}
  @media(max-width:600px){.section-heading p,figcaption{font-size:12px}.zoom-choices button{font-size:11px;padding:10px 12px}}
</style>
