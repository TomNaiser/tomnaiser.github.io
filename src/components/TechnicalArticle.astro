---
import { basePath, href } from '../lib/routes.mjs';
import hardwareMedia from '../data/hardware-media.json';
import astronomyMedia from '../data/astronomy-media.json';
import landscapeMedia from '../data/landscapes-media.json';
import aerialMedia from '../data/aerial-media.json';
import PhotoNavigation from './PhotoNavigation.astro';
import ProjectNavigation from './ProjectNavigation.astro';
import Diagram from './Diagram.astro';
const { lang, id } = Astro.props;
const articles = import.meta.glob('../content/*/*.md', { eager: true });
const document = articles[`../content/${lang}/${id}.md`];
const headings = document.getHeadings().filter((heading) => heading.depth === 2);
const media = [...hardwareMedia, ...astronomyMedia, ...landscapeMedia, ...aerialMedia];
const photoArticle = ['astronomy','landscapes','aerial'].includes(id);
const html = (await document.compiledContent())
  .replace(/src="\/images\//g, `src="${basePath('images/')}`)
  .replace(/(<img\b[^>]*\bsrc="([^"]+)"[^>]*>)/g, (match, tag, src) => {
    const asset = media.find((item) => basePath(item.file) === src);
    const image = asset ? tag.replace('<img ', `<img width="${asset.size[0]}" height="${asset.size[1]}" `) : tag;
    return `<a class="article-image-link" href="${src}" target="_blank" rel="noopener noreferrer">${image}</a>`;
  });
---
{id === 'workflow' && <Diagram id="workflow" lang={lang}/>}
<div class="article-layout detailed-article">
  <aside class="article-aside"><span class="eyebrow">{lang === 'de' ? 'IN DIESEM ARTIKEL' : 'IN THIS ARTICLE'}</span>{headings.map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}{id === 'mechanics' && <a href="#entwicklung">{lang === 'de' ? 'Entwicklung als Diagramm' : 'Development diagram'}</a>}{id === 'software' && <a href="#diagram-software">{lang === 'de' ? 'Ablauf als Diagramm' : 'Workflow diagram'}</a>}{photoArticle ? <a href={href({kind:'photography'},lang)}>{lang === 'de' ? 'Alle Fotografie-Bereiche' : 'All photography collections'} →</a> : <><a href={href({kind:'projects'},lang)}>Hardware & Software ↗</a><a href={href({kind:'project',id:'workflow'},lang)}>Workflow ↗</a></>}</aside>
  <article class="prose" set:html={html}/>
</div>
{id === 'software' && <Diagram id="software" lang={lang}/>}
{id === 'mechanics' && <section id="entwicklung"><Diagram id="history" lang={lang}/></section>}
{photoArticle && <section class="article-next"><h2>{lang === 'de' ? 'Weitere Fotografie entdecken' : 'Explore more photography'}</h2><PhotoNavigation lang={lang} page={{kind:id}}/></section>}
{id === 'mechanics' && <aside class="article-moved"><div id={lang === 'de' ? 'panoboard-elektronik-mit-versionsgeschichte' : 'panoboard-and-its-revisions'}><a class="text-link" href={href({kind:'project',id:'electronics'},lang)}>{lang === 'de' ? 'Platinenbilder und Schaltpläne: zur eigenen Elektronikseite' : 'PCB images and schematics: visit the electronics page'} →</a></div><div id={lang === 'de' ? 'software-und-bedienung-gehören-dazu' : 'software-and-operation'}><a class="text-link" href={href({kind:'project',id:'software'},lang)}>{lang === 'de' ? 'Bedienoberfläche und Steuerung: zur Softwareseite' : 'User interface and control: visit the software page'} →</a></div></aside>}
{['mechanics','electronics','software','workflow'].includes(id) && <section class="article-next"><h2>{lang === 'de' ? 'Weiter im Panoramasystem' : 'Continue exploring the system'}</h2><ProjectNavigation lang={lang} page={{kind:'project',id}}/></section>}
