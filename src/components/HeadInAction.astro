---
const { lang } = Astro.props;
const t = (de,en) => lang === 'de' ? de : en;
const videos = [
  {url:'https://www.youtube.com/shorts/C9Zhq59srMo',title:t('Panoramakopf mit 400-mm-Tele','Panorama head with a 400 mm lens'),description:t('Die automatisierte Plattform mit Kamera und langem Teleobjektiv im Einsatz.','The automated platform in use with a camera and long telephoto lens.')},
  {url:'https://www.youtube.com/shorts/dKAdZi2JLL8',title:t('Die Servo-Plattform in Bewegung','The servo platform in motion'),description:t('Schwenken und Neigen des motorisierten Kamerakopfs im Video.','Watch the motorized camera head pan and tilt.')},
];
---
<section class="head-videos" id="kopf-in-aktion">
  <div class="section-heading"><div><span class="eyebrow">VIDEO / PAN & TILT</span><h2>{t('Der Panoramakopf in Aktion.','The panorama head in action.')}</h2><p>{t('Zwei Videos zeigen die Bewegung und den Aufbau im praktischen Einsatz.','Two videos show the mechanism moving and the setup in use.')}</p></div></div>
  <div class="head-video-grid">{videos.map(video=><a class="head-video-card" href={video.url} target="_blank" rel="noopener noreferrer"><span class="video-play" aria-hidden="true">▶</span><div><h3>{video.title}</h3><p>{video.description}</p><span class="text-link">{t('Auf YouTube ansehen','Watch on YouTube')} ↗</span></div></a>)}</div>
</section>
