---
import '../styles/global.css';
import { href, basePath, ui } from '../lib/routes.mjs';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PhotoNavigation from '../components/PhotoNavigation.astro';
import ProjectNavigation from '../components/ProjectNavigation.astro';
import { isSystemPage } from '../lib/project-navigation.mjs';
const { lang, page, title, description = lang === 'de' ? 'Panoramen, Fotografie und die Technik hinter den Bildern. Von Tom.' : 'Panoramas, photography and the technology behind the images. By Tom.' } = Astro.props;
const other = lang === 'de' ? 'en' : 'de';
const isPublished = import.meta.env.PUBLIC_SITE_LIVE === 'true';
const nav = ['gallery', 'projects', 'workflow', 'photography'];
const navPage = (key) => key === 'workflow' ? {kind:'project',id:'workflow'} : {kind:key};
const navActive = (key) => page.kind === key || (key === 'photography' && ['astronomy','landscapes','aerial'].includes(page.kind)) || (key === 'gallery' && ['gigapan', 'theme', 'region', 'series', 'panorama'].includes(page.kind)) || (key === 'projects' && page.kind === 'project' && page.id !== 'workflow') || (key === 'workflow' && page.kind === 'project' && page.id === 'workflow');
---
<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Tom's Pixel Labs</title><meta name="description" content={description} /><meta name="robots" content={isPublished ? 'index,follow' : 'noindex,nofollow'} />
    <link rel="icon" type="image/svg+xml" href={basePath('favicon.svg')} />
    <link rel="preload" href={basePath('fonts/Manrope-Variable.ttf')} as="font" type="font/ttf" crossorigin />
    <link rel="alternate" hreflang={other} href={new URL(href(page, other), Astro.site).href} />
    <link rel="alternate" hreflang={lang} href={new URL(href(page, lang), Astro.site).href} />
    <link rel="canonical" href={new URL(href(page, lang), Astro.site).href} />
    <script is:inline>try { const theme = localStorage.getItem('pixel-labs-theme'); if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme; } catch {}</script>
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'de' ? 'Zum Inhalt' : 'Skip to content'}</a>
    <header class="site-header wrap">
      <a href={href({kind:'home'}, lang)} class="brand" aria-label={`Tom's Pixel Labs – ${ui[lang].home}`}>
        <svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><path fill="currentColor" d="M0 0h12v12H0zM17 0h12v12H17zM0 17h12v12H0zM17 17h8v8H17z"/></svg>
        <span>Tom's <strong>Pixel Labs</strong><small>PHOTOGRAPHY & ENGINEERING</small></span>
      </a>
      <nav class="desktop-nav" aria-label={lang === 'de' ? 'Hauptnavigation' : 'Main navigation'}>{nav.map((key) => <a aria-current={navActive(key) ? 'page' : undefined} href={href(navPage(key), lang)}>{ui[lang][key]}</a>)}</nav>
      <div class="header-tools"><a class="home-link" href={href({kind:'home'},lang)} aria-label={ui[lang].home} title={ui[lang].home}><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m3 11 9-8 9 8M5 9v12h5v-7h4v7h5V9"/></svg><span>{ui[lang].home}</span></a><div class="language-switch" aria-label={lang === 'de' ? 'Sprache' : 'Language'}><a href={href(page, 'de')} lang="de" aria-current={lang === 'de' ? 'true' : undefined}>DE</a><span>/</span><a href={href(page, 'en')} lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a></div>
        <button type="button" class="theme-toggle" aria-label={ui[lang].themeSwitch} title={ui[lang].themeSwitch}><span aria-hidden="true">◐</span></button>
        <details class="mobile-menu"><summary aria-label={ui[lang].menu}>☰</summary><nav aria-label={ui[lang].menu}>{nav.map((key) => <a aria-current={navActive(key) ? 'page' : undefined} href={href(navPage(key), lang)}>{ui[lang][key]}</a>)}<a href={href({kind:'about'},lang)}>{ui[lang].about}</a><a href={href({kind:'contact'},lang)}>{ui[lang].contact}</a></nav></details>
      </div>
    </header>
    {page.kind !== 'home' && <Breadcrumbs lang={lang} page={page} title={title}/>}
    {isSystemPage(page) && <div class="wrap"><ProjectNavigation lang={lang} page={page}/></div>}
    {['photography','astronomy','landscapes','aerial'].includes(page.kind) && <div class="wrap"><PhotoNavigation lang={lang} page={page}/></div>}
    <main id="main"><slot /></main>
    <footer class="site-footer wrap"><nav class="footer-directory" aria-label={lang === 'de' ? 'Weitere Seiten' : 'More pages'}><a href={href({kind:'gallery'},lang)}>{ui[lang].gallery}</a><a href={href({kind:'project',id:'mechanics'},lang)}>{lang === 'de' ? 'Mechanik' : 'Mechanics'}</a><a href={href({kind:'project',id:'electronics'},lang)}>{lang === 'de' ? 'Elektronik & Platine' : 'Electronics & PCB'}</a><a href={href({kind:'project',id:'software'},lang)}>Software</a><a href={href({kind:'project',id:'workflow'},lang)}>Workflow</a><a href={href({kind:'science'},lang)}>{lang === 'de' ? 'Wissenschaft' : 'Science'}</a><a href={href({kind:'gigapan'},lang)}>{lang === 'de' ? 'Meine Panoramen auf Gigapan' : 'My panoramas on Gigapan'} ↗</a></nav><div class="footer-top"><a class="footer-brand" href={href({kind:'home'},lang)}>Tom's Pixel Labs<span>PHOTOGRAPHY & ENGINEERING</span></a><p>{lang === 'de' ? 'Neugierig bleiben. Genau hinsehen.' : 'Stay curious. Look a little closer.'}</p><div class="footer-links"><a href={href({kind:'about'},lang)}>{ui[lang].about}</a><a class="text-link" href={href({kind:'contact'},lang)}>{ui[lang].contact} ↗</a></div></div><div class="footer-bottom"><span>© 2026 Tom's Pixel Labs</span>{!isPublished && <span>{ui[lang].prototype}</span>}<a href="https://github.com/TomNaiser" target="_blank" rel="noopener noreferrer">GitHub ↗</a></div></footer>
    <script>
      const button = document.querySelector('.theme-toggle');
      button?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('pixel-labs-theme', next); } catch {}
      });
    </script>
  </body>
</html>
